le=&quot;color: rgb(0, 0, 0);&quot;&gt;(n &amp;lt; &lt;/span&gt;&lt;span style=&quot;color: rgb(9, 134, 88);&quot;&gt;2&lt;/span&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;) {&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: rgb(0, 16, 128);&quot;&gt;memo&lt;/span&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;[n] = n;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: rgb(175, 0, 219);&quot;&gt;return&lt;/span&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt; n;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp; &amp;nbsp; }&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: rgb(0, 16, 128);&quot;&gt;memo&lt;/span&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;[n] = &lt;/span&gt;&lt;span style=&quot;color: rgb(121, 94, 38);&quot;&gt;dfs&lt;/span&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;(n - &lt;/span&gt;&lt;span style=&quot;color: rgb(9, 134, 88);&quot;&gt;1&lt;/span&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;) + &lt;/span&gt;&lt;span style=&quot;color: rgb(121, 94, 38);&quot;&gt;dfs&lt;/span&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;(n - &lt;/span&gt;&lt;span style=&quot;color: rgb(9, 134, 88);&quot;&gt;2&lt;/span&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;);&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: rgb(175, 0, 219);&quot;&gt;return&lt;/span&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(0, 16, 128);&quot;&gt;memo&lt;/span&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;[n];&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;}&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
